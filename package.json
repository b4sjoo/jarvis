{
  "name": "jarvis",
  "private": true,
  "version": "0.1.9",
  "description": "A personal desktop meeting assistant for real-time transcription, screen context, and AI guidance.",
  "author": {
    "name": "Jarvis personal fork"
  },
  "license": "GPL-3.0",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "keywords": [
    "ai-assistant",
    "tauri",
    "desktop-app",
    "privacy-first",
    "meeting-assistant",
    "speech-to-text",
    "llm",
    "chatgpt",
    "claude",
    "typescript",
    "react",
    "rust"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node scripts/clean-test-output.mjs && tsc -p tsconfig.test.json && node --test .tmp-tests/tests/**/*.test.js tests/ordered-relation-publication-callback.test.mjs tests/response-opportunity-publication-callback.test.mjs tests/source-linkage-screen-entry.test.mjs tests/pending-answer-publication-callback.test.mjs tests/jarvis-dev-port.test.mjs tests/legacy-chat-retirement.test.mjs tests/legacy-system-audio-retirement.test.mjs tests/task-167-evaluation-ui.test.mjs tests/focus-window-ui.test.mjs tests/preparation-conversation-ui.test.mjs tests/reflect-session-recordings.test.mjs tests/session-evaluation-provenance.test.mjs tests/session-longitudinal-reflection-cli.test.mjs tests/offline-accounting-cli.test.mjs tests/session-procedure-reflection-cli.test.mjs tests/maintainability-deletion-ledger.test.mjs tests/architecture-guardrails.test.mjs tests/tracked-document-boundary.test.mjs tests/next-major-verification.test.mjs tests/buffer-evaluation-inventory.test.mjs tests/manual-pin-artifact-consumer.test.mjs tests/lqu-lock-manual-controls.test.mjs tests/current-evaluation-source.test.mjs tests/focus-feedback.test.mjs tests/focus-display-target.test.mjs tests/focus-correction-ring.test.mjs",
    "verify:deletion-ledger": "node scripts/verify-maintainability-ledger.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs --report",
    "verify:next-major": "node scripts/verify-next-major.mjs",
    "taxonomy:evaluate": "tsc -p tsconfig.taxonomy-evaluation.json && node .tmp-taxonomy-evaluation/scripts/evaluate-taxonomy-corpus.js",
    "intent:corpus:readiness": "tsc -p tsconfig.local-intent-corpus-readiness.json && node .tmp-local-intent-corpus-readiness/scripts/build-local-intent-corpus-readiness.js",
    "intent:corpus:pilot": "tsc -p tsconfig.local-intent-corpus-readiness.json && node .tmp-local-intent-corpus-readiness/scripts/build-local-intent-annotation-pilot.js",
    "intent:corpus:annotate": "tsc -p tsconfig.local-intent-corpus-readiness.json && node .tmp-local-intent-corpus-readiness/scripts/run-local-intent-annotation-workbench.js",
    "taxonomy:model:provision": "node scripts/provision-semantic-taxonomy-model.mjs",
    "taxonomy:semantic:vectors": "tsc -p tsconfig.semantic-taxonomy-vectors.json && node .tmp-semantic-taxonomy-vectors/scripts/generate-semantic-taxonomy-vectors.js",
    "intent:semantic:vectors": "tsc -p tsconfig.semantic-interviewer-intent-vectors.json && node .tmp-semantic-interviewer-intent-vectors/scripts/generate-semantic-interviewer-intent-vectors.js",
    "answer:sufficiency:semantic:vectors": "tsc -p tsconfig.answer-sufficiency-semantic-vectors.json && node .tmp-answer-sufficiency-semantic-vectors/scripts/generate-answer-sufficiency-semantic-vectors.js",
    "answer:sufficiency:reflect": "tsc -p tsconfig.answer-sufficiency-reflection.json && node .tmp-answer-sufficiency-reflection/scripts/reflect-answer-sufficiency-session.js",
    "memory:family:reflect": "tsc -p tsconfig.kmb-interview-family-reflection.json && node .tmp-kmb-interview-family-reflection/scripts/reflect-kmb-interview-family-session.js",
    "memory:evidence:audit": "tsc -p tsconfig.kmb-evidence-audit.json && node .tmp-kmb-evidence-audit/scripts/audit-curated-memory-evidence.js",
    "taxonomy:semantic:evaluate": "tsc -p tsconfig.semantic-taxonomy-evaluation.json && node .tmp-semantic-taxonomy-evaluation/scripts/evaluate-semantic-taxonomy.js",
    "taxonomy:semantic:reflect": "tsc -p tsconfig.semantic-taxonomy-reflection.json && node .tmp-semantic-taxonomy-reflection/scripts/reflect-semantic-taxonomy-session.js",
    "taxonomy:adjudication:reflect": "tsc -p tsconfig.taxonomy-adjudication-reflection.json && node .tmp-taxonomy-adjudication-reflection/scripts/reflect-taxonomy-adjudication-session.js",
    "session:longitudinal:reflect": "tsc -p tsconfig.session-longitudinal-evaluation.json && node .tmp-session-longitudinal-evaluation/scripts/reflect-session-longitudinal-evaluation.js",
    "session:procedure:reflect": "tsc -p tsconfig.session-procedure.json && node .tmp-session-procedure/scripts/compile-session-procedure.js",
    "session:reflect": "node scripts/set-session-evaluation-provenance.mjs",
    "session:reflect:all": "bash scripts/reflect-session-recordings.sh",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@bany/curl-to-json": "^1.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@ricky0123/vad-web": "0.0.24",
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.539.0",
    "mermaid": "^11.12.2",
    "moment": "^2.30.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.12.2",
    "streamdown": "^1.6.10",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tauri-plugin-keychain": "^2.0.1",
    "tauri-plugin-macos-permissions-api": "^2.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
