{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/lib/calling/**/*.ts",
    "tests/moss-*.test.ts"
  ]
