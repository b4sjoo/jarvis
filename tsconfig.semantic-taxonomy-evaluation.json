{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".tmp-semantic-taxonomy-evaluation",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "scripts/evaluate-semantic-taxonomy.ts",
    "src/lib/meeting/semantic-taxonomy-model.ts",
    "src/lib/meeting/semantic-taxonomy-prototypes.ts",
    "src/lib/meeting/semantic-taxonomy-resolver.ts",
    "scripts/lib/taxonomy-evaluation.ts",
    "src/lib/meeting/task-taxonomy.ts",
    "src/lib/memory/types.ts",
    "tests/fixtures/taxonomy-evaluation-corpus.ts",
    "model-manifests/*.json"
  ]
}
